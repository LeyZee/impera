# Copy to .env (ignored by git). Every variable is validated at startup (Zod, apps/api/src/config.ts);
# a missing required variable fails the startup. Single file for api and worker; apps/web uses VITE_* only.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
# Interface the API listens on: this machine alone when unset (localhost). The production image sets 0.0.0.0.
HOST=
# Commit SHA of the running image (Sentry release, worker heartbeat)
RELEASE=dev
# Requests per minute and per IP before 429
RATE_LIMIT_PER_MINUTE=300
# Reverse proxies in front of the API (production: Coolify's Traefik, then the web container's nginx = 2, ADR 0027);
# 0 trusts no forwarded header
TRUST_PROXY_HOPS=0
# Jobs a worker runs at once (jobs of one conversation always stay serial)
WORKER_CONCURRENCY=5

# Database: application role (RLS applies) and admin role (*Unscoped jobs, migrations)
DATABASE_URL=postgres://nirvana_app:change-me@localhost:5432/impera
DATABASE_ADMIN_URL=postgres://nirvana_admin:change-me@localhost:5432/impera
# Docker volume of the development database (docker-compose.yml). Empty: impera-pgdata. A database created before
# the rename keeps its own volume: put the name `docker volume ls` gives.
IMPERA_PGDATA_VOLUME=

# Platform session encryption (AES-256-GCM). Versioned list, newest first: v2:<base64>,v1:<base64>
# Required in production. In development the placeholder counts as unset: sessions cannot be stored.
SESSION_ENCRYPTION_KEYS=v1:replace-with-openssl-rand-base64-32
# AI service keys pasted in Réglages › Modèles IA (ADR 0016), same format, a different key. Required in production;
# unset in development, pasted keys stay in memory until restart.
CREDENTIALS_ENCRYPTION_KEYS=v1:replace-with-openssl-rand-base64-32

# Dashboard auth (Better Auth)
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public URL of the API as the browser sees it: in development the dashboard proxies /v1 to the API
AUTH_BASE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Known-breached password check (ADR 0046 § 4): `off` only on a machine without internet, never in production.
PASSWORD_BREACH_CHECK=on

# AI service keys, development only: in production they are pasted in the dashboard (ADR 0016) and these are ignored.
LLM_XAI_API_KEY=
# Mistral, the writing fallback when Grok does not answer: pasted in Réglages > Modèles IA > Services.
LLM_MISTRAL_API_KEY=
# Venice: no role uses it by default and no screen sets it yet; read here for a role pointed at it by hand.
LLM_VENICE_API_KEY=
# Gemini API (Google AI Studio): the Vision role, photos and videos (Charles, 17/10)
LLM_GOOGLE_API_KEY=
# Voice notes (ElevenLabs)
SPEECH_ELEVENLABS_API_KEY=

# Entraîner > Playground: persona to train on, from the repository root or absolute (the real one lives outside
# the repository; demo persona when empty)
PLAYGROUND_PERSONA_PATH=
# Playground ratings, outside the repository (.scratch/training when empty)
IMPERA_TRAINING_DIR=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted behind Cloudflare Access (operations.md, threat-model.md): traces contain intimate content,
# never send them to Langfuse Cloud.
LANGFUSE_BASE_URL=http://localhost:3001

# Object storage (media), S3-compatible (CR-06 b): her drops go up there straight from her phone. All five or none;
# unset, every send answers 503. The bucket's CORS and its 24-hour rule on `incoming/`: docs/runbooks/deploy.md.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=impera-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Daily encrypted export outside Neon (ADR 0028, service `backup`, docs/runbooks/deploy.md § Sauvegardes).
# Production only. The connection defaults to DATABASE_ADMIN_URL (the dump needs BYPASSRLS). The recipient is the
# PUBLIC age key (age1…): the private key never reaches the server. The bucket is at Hetzner, not at Neon's provider;
# its credentials can write but not delete.
BACKUP_DATABASE_URL=
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Invoices' PDFs (EQ-06 lot 4, ADR 0037, docs/runbooks/deploy.md § 4.3). Two S3-compatible buckets with Object Lock in
# compliance mode: Hetzner (a project of its own, not the backups' one), then the copy at OVHcloud. Each key can write,
# read and list, and lengthen a lock, never delete. All five of a bucket or none; both required in production, each at
# an https endpoint, the copy at another host (the API refuses to start otherwise). Empty in development: the PDFs are
# kept in memory, lost with the process.
INVOICES_S3_ENDPOINT=
INVOICES_S3_REGION=
INVOICES_S3_BUCKET=
INVOICES_S3_ACCESS_KEY_ID=
INVOICES_S3_SECRET_ACCESS_KEY=
INVOICES_COPY_S3_ENDPOINT=
INVOICES_COPY_S3_REGION=
INVOICES_COPY_S3_BUCKET=
INVOICES_COPY_S3_ACCESS_KEY_ID=
INVOICES_COPY_S3_SECRET_ACCESS_KEY=

# Web Push (PWA, phase 5)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Dev: run the worker inside the API process
IMPERA_INLINE_WORKER=1

# Recette sandbox (ADR 0075, docs/recette/bac-a-sable.md): 1 aims the real adapters and key verifiers at the local
# fake world of `pnpm sandbox:world` and blocks every call outside this machine. Development only: production and
# any non-local AUTH_BASE_URL, WEB_ORIGIN or S3_ENDPOINT refuse to start with it.
IMPERA_SANDBOX=0
IMPERA_SANDBOX_URL=
