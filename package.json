{
  "name": "impera",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Agent de chatting pour créatrice de contenu : connecteurs de plateformes, moteur IA supervisé, mémoire fan, dashboard.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "lefthook install || echo \"lefthook install skipped (no git repository)\"",
    "dev": "turbo run dev --parallel",
    "dev:crm": "turbo run dev --parallel --filter=@impera/api --filter=@impera/web",
    "build": "turbo run build",
    "check": "turbo run typecheck lint && prettier --check . && knip && node scripts/check-repo.mjs && pnpm --filter @impera/db drift",
    "check:repo": "node scripts/check-repo.mjs",
    "sessions:log": "node scripts/session-log.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:all": "pnpm test && pnpm test:integration",
    "db:generate": "pnpm --filter @impera/db generate",
    "db:migrate": "pnpm --filter @impera/db migrate",
    "db:studio": "pnpm --filter @impera/db studio",
    "owner:create": "pnpm --filter @impera/api owner:create",
    "creator:create": "pnpm --filter @impera/api creator:create",
    "db:rebuild-projections": "pnpm --filter @impera/api rebuild-projections",
    "persona:validate": "pnpm --filter @impera/api persona:validate",
    "persona:load": "pnpm --filter @impera/api persona:load",
    "ops:kill-switch": "pnpm --filter @impera/api ops:kill-switch",
    "ops:revoke-sessions": "pnpm --filter @impera/api ops:revoke-sessions",
    "ops:reset-second-factor": "pnpm --filter @impera/api ops:reset-second-factor",
    "ops:reencrypt-sessions": "pnpm --filter @impera/api ops:reencrypt-sessions",
    "ops:reencrypt-credentials": "pnpm --filter @impera/api ops:reencrypt-credentials",
    "ops:check-keys": "pnpm --filter @impera/api ops:check-keys",
    "evals": "pnpm --filter @impera/evals run evals",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "probe": "pnpm --filter @impera/evals run probe",
    "probe:vision": "pnpm --filter @impera/evals run probe:vision",
    "playground": "pnpm --filter @impera/api run playground",
    "sandbox:world": "pnpm --filter @impera/api sandbox:world"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
