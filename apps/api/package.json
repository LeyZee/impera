{
  "name": "@impera/api",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "API Fastify et worker Graphile d’Impera : même code, deux entrées (src/index.ts, src/worker.ts).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "test:integration": "vitest run --config vitest.integration.config.ts --fsModuleCachePath node_modules/.vitest-cache",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --fsModuleCachePath node_modules/.vitest-cache",
    "playground": "tsx --env-file-if-exists=../../.env src/scripts/playground.ts",
    "owner:create": "tsx --env-file-if-exists=../../.env src/scripts/create-owner.ts",
    "creator:create": "tsx --env-file-if-exists=../../.env src/scripts/create-creator.ts",
    "evals": "tsx --env-file-if-exists=../../.env src/scripts/evals.ts",
    "persona:validate": "tsx src/scripts/persona-validate.ts",
    "persona:load": "tsx --env-file-if-exists=../../.env src/scripts/persona-load.ts",
    "rebuild-projections": "tsx --env-file-if-exists=../../.env src/scripts/rebuild-projections.ts",
    "ops:kill-switch": "tsx --env-file-if-exists=../../.env src/scripts/ops-kill-switch.ts",
    "ops:revoke-sessions": "tsx --env-file-if-exists=../../.env src/scripts/ops-revoke-sessions.ts",
    "ops:reset-second-factor": "tsx --env-file-if-exists=../../.env src/scripts/ops-reset-second-factor.ts",
    "ops:reencrypt-sessions": "tsx --env-file-if-exists=../../.env src/scripts/ops-reencrypt-sessions.ts",
    "ops:reencrypt-credentials": "tsx --env-file-if-exists=../../.env src/scripts/ops-reencrypt-credentials.ts",
    "ops:check-keys": "tsx --env-file-if-exists=../../.env src/scripts/ops-check-keys.ts",
    "sandbox:world": "tsx --env-file-if-exists=../../.env src/__tests__/sandbox-world/main.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/server": "13.3.3",
    "aws4fetch": "1.0.20",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "graphile-worker": "0.18.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@impera/contracts": "workspace:*",
    "@impera/db": "workspace:*",
    "@impera/llm": "workspace:*",
    "@types/fontkit": "2.0.9",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.7",
    "eslint": "10.13.0",
    "pdfjs-dist": "6.3.289",
    "testcontainers": "12.2.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
