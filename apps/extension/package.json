{
  "name": "@impera/extension",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Extension Chrome Impera (WXT, Manifest V3) : enregistreur réseau, capture de session, relais d'actions.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@impera/contracts": "workspace:*",
    "@impera/design-system": "workspace:*",
    "zod": "4.6.7"
  }
}
