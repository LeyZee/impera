# Rendered by the nginx image at start (envsubst on ${API_UPSTREAM} and ${MEDIA_ORIGIN}). The only public entry of a
# deployment: Coolify's proxy → this server → the API, which therefore runs with TRUST_PROXY_HOPS=2.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # A client that sends its request or reads its answer too slowly lets go of its connection: without these, a few
    # thousand idle connections would hold the proxy (the read of the API's answer keeps its own, longer limit below).
    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 60s;
    keepalive_timeout 30s;
    # The session cookie and a few headers: far under this. Anything larger is refused (400/414) before the API.
    large_client_header_buffers 4 8k;

    # Docker's embedded DNS, read at each request: nginx starts even while the API is still booting.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://${API_UPSTREAM};

    # Security headers on the app's files only: under /v1 the API sets its own (helmet), never twice.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /v1/ {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # Same ceiling as the API's body limit (1 MiB): a larger body never leaves the proxy.
        client_max_body_size 1m;
        proxy_read_timeout 90s;
    }

    # The captures of a marked post (VEI-01 c2, ADR 0060 § 2): four captures in base64 pass the API's 1 MiB, the route
    # takes up to 4 MiB; the vision answers within its two models' timeouts (90 s each), so the read waits longer.
    location = /v1/trends/readings/captures {
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        client_max_body_size 4m;
        proxy_read_timeout 200s;
    }

    # The calendar feed (CR-12, ADR 0045 § 5): its secret is in the path, so this location keeps no access log, and
    # its error log only what stops nginx itself (an API that does not answer would otherwise write the URL there).
    # The API logs nothing below `warn` for it either.
    location /v1/calendar-feed/ {
        access_log off;
        error_log /dev/stderr crit;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        client_max_body_size 1k;
        proxy_read_timeout 30s;
    }

    # Hashed by Vite: cached for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # The router lives in the browser: any other path gets the app, never cached so a deployment shows at once.
    location / {
        add_header Cache-Control "no-cache" always;
        # HTTPS only from the first visit on, the same rule helmet sends under /v1 (same host): includeSubDomains
        # binds only the subdomains of the dashboard's own host, and none lives there.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        # Nothing of the device the dashboard does not use; WebAuthn (passkeys, Face ID) and the microphone stay
        # open to this origin alone.
        add_header Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), microphone=(self), publickey-credentials-get=(self), publickey-credentials-create=(self)" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        # Scripts, fonts, images and API calls from this origin only; no inline script, no frame, no plugin. The one
        # exception is the media bucket (MEDIA_ORIGIN, its S3_ENDPOINT), where her phone sends her files (CR-06 b).
        # Inline styles stay allowed: React sets `style` attributes, which only 'unsafe-inline' lets through
        # everywhere (style-src-attr is not in every Safari the team uses).
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' ${MEDIA_ORIGIN}; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;
        try_files $uri $uri/ /index.html;
    }
}
